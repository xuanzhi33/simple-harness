# OpenRouter API key (required)
OPENROUTER_API_KEY=

# Model id on OpenRouter (e.g. deepseek/deepseek-chat, openai/gpt-4o-mini)
MODEL=deepseek/deepseek-chat

# Optional: your site/app identity shown on OpenRouter rankings (recommended)
# SITE_URL=
# APP_NAME=simple-harness

# Optional: agent loop cap
# MAX_ITERATIONS=20

# Optional: reasoning effort (low | medium | high). Default: not sent.
# Sent as { reasoning: { effort } } — OpenRouter unified format.
# REASONING_EFFORT=medium

# Optional: bash tool max output lines / bytes before truncation
# BASH_MAX_LINES=2000
# BASH_MAX_BYTES=51200
